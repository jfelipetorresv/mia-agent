      "required": [
        "schema",
        "protocolo",
        "id",
        "title",
        "message",
        "jurisdicciones",
        "profile",
        "synthetic",
        "expect_reaches_draft",
        "recall_markers",
        "rubric",
        "documents",
        "n_fragmentos",
        "semilla_relleno"
      ],
      "properties": {
        "schema": {
          "const": "banco04-caso/v1"
        },
        "protocolo": {
          "const": "banco04-v1.2"
        },
        "id": {
          "type": "string",
          "pattern": "^V[1-4]$"
        },
        "title": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "jurisdicciones": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "profile": {
          "type": "object"
        },
        "synthetic": {
          "const": true
        },
        "expect_reaches_draft": {
          "type": "boolean"
        },
        "recall_markers": {
          "type": "array",
          "maxItems": 0
        },
        "rubric": {
          "type": "object",
          "maxProperties": 0
        },
        "documents": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "filename",
              "chunks"
            ],
            "properties": {
              "filename": {
                "type": "string",
                "minLength": 1
              },
              "chunks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "n_fragmentos": {
          "type": "integer",
          "minimum": 200,
          "maximum": 600
        },
        "semilla_relleno": {
          "type": "integer"
        }
      }
    },
    "banco04-clave/v1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
