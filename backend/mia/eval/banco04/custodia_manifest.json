        "protocolo",
        "case_id",
        "base_indice_fragmento",
        "n_fragmentos",
        "orden_documentos",
        "hechos_materiales",
        "puntos_materiales",
        "conclusion_correcta",
        "conclusiones_erroneas_previsibles",
        "conducta_bajo_cobertura_parcial",
        "distractores",
        "normas_ficticias",
        "propiedades_construccion",
        "marcadores_auxiliares",
        "notas"
      ],
      "properties": {
        "schema": {
          "const": "banco04-clave/v1"
        },
        "protocolo": {
          "const": "banco04-v1.2"
        },
        "case_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "base_indice_fragmento": {
          "const": 0
        },
        "n_fragmentos": {
          "type": "integer",
          "minimum": 0
        },
        "orden_documentos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hechos_materiales": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "enunciado",
              "documento",
              "documento_orden",
              "fragmentos",
              "fragmento_principal",
              "posicion_relativa_en_documento",
              "posicion_global",
              "posicion_global_relativa",
              "enterrado",
              "marcador_auxiliar",
              "literales_exclusivos",
              "decisivo",
              "rol"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "enunciado": {
                "type": "string",
                "minLength": 1
              },
              "documento": {
                "type": "string"
              },
              "documento_orden": {
                "type": "integer",
                "minimum": 0
              },
              "fragmentos": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "fragmento_principal": {
                "type": "integer",
                "minimum": 0
              },
              "posicion_relativa_en_documento": {
                "type": "number"
              },
              "posicion_global": {
                "type": "integer"
              },
              "posicion_global_relativa": {
                "type": "number"
              },
              "enterrado": {
                "type": "boolean"
              },
              "marcador_auxiliar": {
                "type": "string",
                "minLength": 1
              },
              "literales_exclusivos": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "decisivo": {
                "type": "boolean"
              },
              "rol": {
                "type": "string"
              }
            }
          }
        },
        "puntos_materiales": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "enunciado",
              "tipo",
              "depende_de_hechos",
              "fragmentos"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "enunciado": {
                "type": "string"
              },
              "tipo": {
                "enum": [
                  "conclusion",
                  "laguna_real",
                  "conflicto",
                  "excepcion"
                ]
              },
              "depende_de_hechos": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "fragmentos": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "documento",
                    "fragmento"
                  ],
                  "properties": {
                    "documento": {
                      "type": "string"
                    },
                    "fragmento": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        },
        "conclusion_correcta": {
          "type": "string",
          "minLength": 1
        },
        "conclusiones_erroneas_previsibles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conducta_bajo_cobertura_parcial": {
          "type": "object",
          "required": [
            "alcance_esperado",
            "conducta_exigida",
            "descripcion",
            "debe_nombrar",
            "no_debe"
          ]
        },
        "distractores": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "literal",
              "documento",
              "fragmento",
              "nota"
            ]
          }
        },
        "normas_ficticias": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "propiedades_construccion": {
          "type": "object"
        },
        "marcadores_auxiliares": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notas": {
          "type": "object"
        }
      }
    },
    "banco04-mutaciones/v1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "protocolo",
        "conjunto",
        "uso",
        "base",
        "regla_de_deteccion",
        "categorias",
        "items",
        "resumen"
      ],
      "properties": {
        "schema": {
          "const": "banco04-mutaciones/v1"
        },
        "protocolo": {
          "const": "banco04-v1.2"
        },
        "conjunto": {
          "enum": [
            "ajuste",
            "reservado"
          ]
        },
        "uso": {
          "enum": [
            "depuracion_de_prompts",
            "un_solo_uso_con_prompts_congelados"
          ]
        },
        "base": {
          "type": "string"
        },
        "regla_de_deteccion": {
          "type": "string"
        },
        "categorias": {
          "type": "object",
          "patternProperties": {
            "^C[0-9]{2}$": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "resumen": {
          "type": "object",
          "required": [
            "salidas",
            "defectos",
            "controles",
            "clausulas_falsas_breves",
            "por_categoria"
          ]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "jurisdicciones",
              "material",
              "salida",
              "verdad"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^M[AR]-[0-9]{2}$"
              },
              "jurisdicciones": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "material": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mensaje_abogado",
                  "documentos",
                  "mapa_doc",
                  "piezas_fuera_del_mapa",
                  "fuentes_corpus",
                  "aviso_alcance"
                ],
                "properties": {
                  "mensaje_abogado": {
                    "type": "string"
                  },
                  "documentos": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "filename",
                        "chunks"
                      ],
                      "properties": {
                        "filename": {
                          "type": "string",
                          "minLength": 1
                        },
                        "chunks": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  },
                  "mapa_doc": {
                    "type": "object",
                    "patternProperties": {
                      "^[0-9]+$": {
                        "type": "object",
                        "required": [
                          "documento",
                          "fragmento"
                        ],
                        "properties": {
                          "documento": {
                            "type": "string"
                          },
                          "fragmento": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      }
                    },
                    "additionalProperties": false
                  },
                  "piezas_fuera_del_mapa": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "documento",
                        "fragmento"
                      ]
                    }
                  },
                  "fuentes_corpus": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "ref",
                        "texto",
                        "ficticia"
                      ],
                      "properties": {
                        "ref": {
                          "type": "string",
                          "pattern": "^corpus:"
                        },
                        "texto": {
                          "type": "string"
                        },
                        "ficticia": {
                          "const": true
                        }
                      }
                    }
                  },
                  "aviso_alcance": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "salida": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "diagnostico",
                  "borrador"
                ],
                "properties": {
                  "diagnostico": {
                    "type": "string"
                  },
                  "borrador": {
                    "type": "string"
                  }
                }
              },
              "verdad": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "clase",
                    "categoria",
                    "campo",
                    "inicio",
                    "fin",
                    "literal",
                    "estado_esperado",
                    "estados_aceptables",
                    "subtipo_esperado",
                    "nota"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "clase": {
                      "enum": [
                        "defecto",
                        "control"
                      ]
                    },
                    "categoria": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "pattern": "^C[0-9]{2}$"
                    },
                    "campo": {
                      "enum": [
                        "diagnostico",
                        "borrador"
                      ]
                    },
                    "inicio": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "fin": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "literal": {
                      "type": "string",
                      "minLength": 1
                    },
                    "estado_esperado": {
                      "enum": [
                        "con_respaldo",
                        "con_respaldo_sin_localizador",
                        "localizador_falso",
                        "marcada_correctamente",
                        "marcada_innecesariamente",
                        "dicho_abogado_fiel",
                        "inferencia_valida",
                        "sin_respaldo",
                        "no_aplica"
                      ]
                    },
                    "estados_aceptables": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "con_respaldo",
                          "con_respaldo_sin_localizador",
                          "localizador_falso",
                          "marcada_correctamente",
                          "marcada_innecesariamente",
                          "dicho_abogado_fiel",
                          "inferencia_valida",
                          "sin_respaldo",
                          "no_aplica"
                        ]
                      }
                    },
                    "subtipo_esperado": {
                      "enum": [
                        "hecho",
                        "juridica_sin_cita",
                        "cita_no_sostiene",
                        "contradicha_por_expediente",
                        "negativa_falsa",
                        "procedencia",
                        "fuga",
                        "localizador_falso",
                        null
                      ]
                    },
                    "oracion": {
                      "type": "string"
                    },
                    "proporcion_en_oracion": {
                      "type": "number",
                      "exclusiveMaximum": 0.2
                    },
                    "original": {
